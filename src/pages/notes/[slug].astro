---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import { withBase } from '../../utils/url';
import { estimateReadingTime, formatDate } from '../../utils/readingTime';

export async function getStaticPaths() {
  const notes = (await getCollection('notes'))
    .filter((n) => !n.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      prev: index > 0 ? notes[index - 1] : null,
      next: index < notes.length - 1 ? notes[index + 1] : null,
    },
  }));
}

const { note, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const { title, summary, category, date, updated, tags } = note.data;
const readingMinutes = estimateReadingTime(note.body);
---

<BaseLayout title={title} description={summary}>
  <article class="section">
    <div class="container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href={withBase('/')}>首页</a>
        <span>/</span>
        <a href={withBase('/notes')}>技术笔记</a>
        <span>/</span>
        <span>{category}</span>
      </nav>

      <header class="note-header">
        <div class="note-meta">
          <span class="tag tag-accent">{category}</span>
          <span>发布于 {formatDate(date)}</span>
          {updated && <span>· 更新于 {formatDate(updated)}</span>}
          <span>· 预计阅读 {readingMinutes} 分钟</span>
        </div>
        <h1 class="note-title">{title}</h1>
        <p class="note-summary">{summary}</p>
      </header>

      <div class="article-layout">
        <div class="article-main">
          <div class="prose">
            <Content />
          </div>

          {
            tags.length > 0 && (
              <div class="article-tags">
                {tags.map((t) => (
                  <span class="tag">#{t}</span>
                ))}
              </div>
            )
          }

          <nav class="pager" aria-label="相邻笔记">
            {
              prev ? (
                <a href={withBase(`/notes/${prev.id}`)} class="pager-link">
                  <span class="pager-label">← 较新的一篇</span>
                  <span class="pager-title">{prev.data.title}</span>
                </a>
              ) : (
                <div />
              )
            }
            {
              next && (
                <a href={withBase(`/notes/${next.id}`)} class="pager-link is-next">
                  <span class="pager-label">较早的一篇 →</span>
                  <span class="pager-title">{next.data.title}</span>
                </a>
              )
            }
          </nav>
        </div>

        <aside class="article-aside">
          <TOC headings={headings} title="文章目录" />
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .note-header {
    padding-bottom: 28px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--border);
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 14px;
  }

  .note-title {
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    max-width: 28ch;
  }

  .note-summary {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 64ch;
    line-height: 1.72;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }
</style>
