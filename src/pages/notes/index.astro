---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteItem from '../../components/NoteItem.astro';

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categoryCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();

for (const n of notes) {
  categoryCounts.set(n.data.category, (categoryCounts.get(n.data.category) || 0) + 1);
  for (const tag of n.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

const categories = Array.from(categoryCounts.entries());
const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="技术笔记" description="结构化的技术美术知识库：渲染管线、Shader 算法、DCC 工具开发与性能优化笔记。">
  <section class="page-head studio-backdrop">
    <div class="container">
      <p class="section-eyebrow">Knowledge Base</p>
      <h1 class="page-title">技术笔记</h1>
      <p class="page-desc">
        笔记。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container notes-shell">
      <aside class="notes-sidebar" aria-label="笔记索引与筛选">
        <div class="sidebar-block">
          <label for="note-search" class="sidebar-label">关键词检索</label>
          <input
            id="note-search"
            type="search"
            class="search-input"
            placeholder="搜索 Shader、URP、Python..."
            autocomplete="off"
          />
        </div>

        <div class="sidebar-block">
          <div class="sidebar-label">分类目录</div>
          <ul class="cat-list">
            <li>
              <button type="button" class="cat-btn is-active" data-cat="全部">
                <span>全部笔记</span>
                <span class="cat-count">{notes.length}</span>
              </button>
            </li>
            {
              categories.map(([cat, count]) => (
                <li>
                  <button type="button" class="cat-btn" data-cat={cat}>
                    <span>{cat}</span>
                    <span class="cat-count">{count}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        {
          tags.length > 0 && (
            <div class="sidebar-block">
              <div class="sidebar-label">常用标签</div>
              <div class="tag-cloud">
                {tags.map(([tag]) => (
                  <button type="button" class="tag-btn" data-tag={tag}>
                    #{tag}
                  </button>
                ))}
              </div>
            </div>
          )
        }
      </aside>

      <div class="notes-main">
        <div class="notes-status">
          <span id="notes-count">共 {notes.length} 篇笔记</span>
          <button type="button" id="notes-reset" class="reset-btn" hidden>清除筛选</button>
        </div>

        <div class="note-list" id="notes-list">
          {notes.map((note) => <NoteItem note={note} />)}
        </div>

        <p class="empty-tip" id="notes-empty" hidden>没有找到匹配的技术笔记，试试换个关键词。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 52px 0 36px;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: clamp(1.75rem, 3vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  .page-desc {
    margin: 0;
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .notes-shell {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  .notes-sidebar {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-block {
    padding: 16px 18px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .sidebar-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .search-input {
    width: 100%;
    padding: 9px 12px;
    border-radius: 9px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.18s ease;
  }

  .search-input:focus {
    border-color: var(--accent);
  }

  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cat-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .cat-btn:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .cat-btn.is-active {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-border);
    font-weight: 560;
  }

  .cat-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-btn {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .tag-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .tag-btn.is-active {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent-border);
  }

  .notes-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .reset-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0;
  }

  .reset-btn:hover {
    text-decoration: underline;
  }

  .empty-tip {
    text-align: center;
    padding: 48px 0;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .notes-shell {
      grid-template-columns: 1fr;
    }

    .notes-sidebar {
      position: static;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('note-search');
    const catButtons = Array.from(document.querySelectorAll('.cat-btn'));
    const tagButtons = Array.from(document.querySelectorAll('.tag-btn'));
    const rows = Array.from(document.querySelectorAll('#notes-list .note-row'));
    const countEl = document.getElementById('notes-count');
    const resetBtn = document.getElementById('notes-reset');
    const emptyTip = document.getElementById('notes-empty');

    let activeCat = '全部';
    let activeTag = '';
    let query = '';

    const applyFilter = () => {
      let visible = 0;
      rows.forEach((row) => {
        const cat = row.getAttribute('data-category') || '';
        const tags = (row.getAttribute('data-tags') || '').split(',').filter(Boolean);
        const text = row.getAttribute('data-search') || '';

        const matchCat = activeCat === '全部' || cat === activeCat;
        const matchTag = !activeTag || tags.includes(activeTag);
        const matchQuery = !query || text.includes(query);

        const show = matchCat && matchTag && matchQuery;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countEl) countEl.textContent = `显示 ${visible} / ${rows.length} 篇笔记`;
      if (emptyTip) emptyTip.hidden = visible > 0;
      if (resetBtn) resetBtn.hidden = activeCat === '全部' && !activeTag && !query;
    };

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.getAttribute('data-cat') || '全部';
        catButtons.forEach((b) => b.classList.toggle('is-active', b === btn));
        applyFilter();
      });
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        activeTag = activeTag === tag ? '' : tag;
        tagButtons.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-tag') === activeTag));
        applyFilter();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      query = (e.target.value || '').trim().toLowerCase();
      applyFilter();
    });

    resetBtn?.addEventListener('click', () => {
      activeCat = '全部';
      activeTag = '';
      query = '';
      if (searchInput) searchInput.value = '';
      catButtons.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-cat') === '全部'));
      tagButtons.forEach((b) => b.classList.remove('is-active'));
      applyFilter();
    });
  });
</script>
