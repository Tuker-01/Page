---
import { SITE } from '../config/site';
import { withBase } from '../utils/url';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const normalized = currentPath.startsWith(base) ? currentPath.slice(base.length) || '/' : currentPath;

const navItems = [
  { label: '首页', href: '/' },
  { label: '作品集', href: '/works' },
  { label: '技术笔记', href: '/notes' },
  { label: '关于', href: '/about' },
];

function isActive(href: string): boolean {
  if (href === '/') return normalized === '/' || normalized === '';
  return normalized.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={withBase('/')} class="brand" aria-label={SITE.brand}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">{SITE.brand}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} class:list={['nav-link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="theme-toggle"
      type="button"
      class="theme-btn"
      aria-label="切换深浅色主题"
      title="切换深浅色主题"
    >
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: var(--bg-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-weight: 650;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--accent), var(--accent-warm));
    box-shadow: 0 0 12px var(--accent-soft);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link {
    padding: 6px 13px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-link.is-active {
    color: var(--text);
    background: var(--bg-subtle);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .theme-btn {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
  }

  .theme-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(html[data-theme='light']) .icon-sun {
    display: none;
  }

  @media (max-width: 600px) {
    .brand-text {
      display: none;
    }

    .nav {
      gap: 2px;
    }

    .nav-link {
      padding: 6px 10px;
      font-size: 0.85rem;
    }
  }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    localStorage.setItem('ta-theme', next);
  });
</script>
